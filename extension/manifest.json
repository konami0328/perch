{
  "manifest_version": 3,
  "name": "Perch",
  "version": "0.1.0",
  "description": "A lightweight co-study room. No accounts, just a code and a friend.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Perch"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:8000/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["room.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
